# Copy these into Vercel Project Settings -> Environment Variables
# (Do NOT commit a real .env file with real secrets to a public repo)

# Secret only your laptops know - must match AGENT_TOKEN in agent.py
AGENT_TOKEN=change-this-to-a-long-random-secret

# Password you type into the dashboard on your phone/browser
VIEWER_PASSWORD=choose-your-own-password

# These are auto-filled when you add the Vercel KV (Storage) integration
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
